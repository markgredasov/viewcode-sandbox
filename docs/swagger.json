        "/verifications": {
            "post": {
                "description": "Создает верификацию (добавляет тесты для проблемы для выбранного языка). В теле запроса код должен быть закодирован в стандарте base64",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Verifications"
                ],
                "summary": "Создать верификацию",
                "parameters": [
                    {
                        "description": "Request body",
                        "name": "RequestBody",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_handler_verifications.VerificationDTORequest"
                        }
                    },
                    {
                        "type": "string",
                        "description": "Формат кодирования верификационного кода (доступен base64)",
                        "name": "format",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Созданная верификация",
                        "schema": {
                            "$ref": "#/definitions/internal_handler_verifications.VerificationDTOResponse"
                        }
                    },
                    "400": {
                        "description": "Ошибка при валидации запроса",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Проблема с таким ID не найдена",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Верификация для выбранной задачи и языка уже существует",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/verifications/{problem_id}": {
            "get": {
                "description": "Ищет верификацию по ID проблемы и выбранному языку программирования",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Verifications"
                ],
                "summary": "Найти верификацию по ProblemID и языку",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Язык программирования (go, py, java, cpp, js, ts, csharp, ko, sw, rust)",
                        "name": "language",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Идентификатор задачи",
                        "name": "problem_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Найденная верификация",
                        "schema": {
                            "$ref": "#/definitions/internal_handler_verifications.VerificationDTOResponse"
                        }
                    },
                    "400": {
                        "description": "Ошибка при валидации запроса",
