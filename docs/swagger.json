                    "application/json"
                ],
                "tags": [
                    "Problems"
                ],
                "summary": "Получить список всех задач",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Уровень сложности задач (easy, medium, hard)",
                        "name": "complexity",
