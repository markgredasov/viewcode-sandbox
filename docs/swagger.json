        "/problems/{id}": {
            "get": {
                "description": "Отдает задачу на viewcode по ее UUID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Problems"
                ],
                "summary": "Получить список задачи по ее UUID",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Идентификатор задачи",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Задача с указанным ID",
                        "schema": {
                            "$ref": "#/definitions/internal_handler_problems.ProblemDTOResponse"
                        }
                    },
                    "400": {
                        "description": "Ошибка при создании модели проблемы / ID не был передан в запросе или имеет неправильный формат",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Задача с таким ID не была найдена",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Удаляет задачу по ее ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Problems"
                ],
                "summary": "Удалить задачу",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Идентификатор задачи",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Задача успешно удалена"
                    },
                    "400": {
                        "description": "Ошибка при создании модели проблемы / ID не был передан в запросе или имеет неправильный формат",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Задача с таким ID не была найдена",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/github_com_markgredasov_viewcode-sandbox_internal_server_http_response.ErrorResponse"
                        }
                    }
                }
            }
